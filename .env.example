# Copy to .env and fill in real values. NEVER commit .env.

# Your domain — its A/AAAA record must point at this VPS (needed for Let's Encrypt).
DOMAIN=gophkeeper.example.com

# Postgres credentials (used by both the postgres and gophkeeper services).
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=gophkeeper_db

# JWT signing secret. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# The built-in dev default is INSECURE and must be overridden here.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-secret
