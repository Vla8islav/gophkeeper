# Caddy auto-provisions and auto-renews a Let's Encrypt cert for $DOMAIN and
# reverse-proxies to the gophkeeper server over the internal compose network.
#
# TIP: while testing, add this global option to use Let's Encrypt's STAGING CA
# (avoids rate limits); remove it for the real cert:
#   { acme_ca https://acme-staging-v02.api.letsencrypt.org/directory }

{$DOMAIN} {
	reverse_proxy gophkeeper:8080
}
